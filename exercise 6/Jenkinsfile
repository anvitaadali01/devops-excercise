pipeline {
    agent { label 'linux-docker' }

    environment {
        PROMETHEUS_IMAGE = 'prom/prometheus:v3.5.0'
        GRAFANA_IMAGE = 'grafana/grafana:12.1.0'
        CURL_IMAGE = 'curlimages/curl:8.12.1'
    }

    stages {
        stage('Prepare isolated names') {
            steps {
                script {
                    def safeJob = env.JOB_NAME.toLowerCase().replaceAll(/[^a-z0-9_.-]/, '-').take(35)
                    env.STACK_ID = "ex6-${safeJob}-${env.BUILD_NUMBER}"
                    env.METRICS_IMAGE = "ex6-delivery-metrics:${safeJob}-${env.BUILD_NUMBER}"
                }
            }
        }

        stage('Check Docker') {
            steps {
                sh 'docker version && docker info'
            }
        }

        stage('Validate application') {
            steps {
                dir('Ex 6') {
                    sh '''
                        set -eu
                        python3 -c 'import sys; assert sys.version_info >= (3, 10), sys.version'
                        python3 -m py_compile delivery_metrics.py
                        test -s requirements.txt
                        test -s prometheus.yml
                        test -s alert_rules.yml
                    '''
                }
            }
        }

        stage('Build metrics image') {
            steps {
                dir('Ex 6') {
                    sh 'docker build --tag "$METRICS_IMAGE" .'
                }
            }
        }

        stage('Run and verify monitoring stack') {
            steps {
                dir('Ex 6') {
                    sh '''
                        set -eu
                        docker network create "$STACK_ID"
                        docker run --detach --name "${STACK_ID}-metrics" \
                            --network "$STACK_ID" --network-alias delivery-metrics \
                            "$METRICS_IMAGE"
                        docker run --detach --name "${STACK_ID}-prometheus" \
                            --network "$STACK_ID" --network-alias prometheus \
                            --mount "type=bind,src=$PWD/prometheus.yml,dst=/etc/prometheus/prometheus.yml,readonly" \
                            --mount "type=bind,src=$PWD/alert_rules.yml,dst=/etc/prometheus/alert_rules.yml,readonly" \
                            "$PROMETHEUS_IMAGE" \
                            --config.file=/etc/prometheus/prometheus.yml
                        docker run --detach --name "${STACK_ID}-grafana" \
                            --network "$STACK_ID" --network-alias grafana \
                            "$GRAFANA_IMAGE"

                        metrics_output=$(docker run --rm --network "$STACK_ID" \
                            "$CURL_IMAGE" --fail --silent \
                            http://delivery-metrics:8000/metrics)
                        printf '%s\\n' "$metrics_output" | grep -q '^total_deliveries '
                        printf '%s\\n' "$metrics_output" | grep -q '^average_delivery_time_count '

                        target_up=
                        for attempt in $(seq 1 30); do
                            query_output=$(docker run --rm --network "$STACK_ID" \
                                "$CURL_IMAGE" --fail --silent --get \
                                --data-urlencode 'query=up{job="delivery_service"}' \
                                http://prometheus:9090/api/v1/query 2>/dev/null || true)
                            if printf '%s' "$query_output" | python3 -c 'import json, sys; payload=json.load(sys.stdin); assert any(sample["value"][1] == "1" for sample in payload["data"]["result"])'; then
                                target_up=yes
                                break
                            fi
                            sleep 2
                        done
                        test "$target_up" = yes
                        rules_output=$(docker run --rm --network "$STACK_ID" \
                            "$CURL_IMAGE" --fail --silent \
                            http://prometheus:9090/api/v1/rules)
                        printf '%s' "$rules_output" | grep -q 'HighPendingDeliveries'
                        printf '%s' "$rules_output" | grep -q 'HighAverageDeliveryTime'
                        docker run --rm --network "$STACK_ID" "$CURL_IMAGE" \
                            --fail --silent --retry 20 --retry-delay 2 \
                            http://grafana:3000/api/health >/dev/null
                        echo 'Metrics endpoint, Prometheus delivery target, and Grafana health verified.'
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                if [ -n "${STACK_ID:-}" ]; then
                    docker logs "${STACK_ID}-metrics" 2>/dev/null || true
                    docker rm --force "${STACK_ID}-grafana" "${STACK_ID}-prometheus" "${STACK_ID}-metrics" 2>/dev/null || true
                    docker network rm "$STACK_ID" 2>/dev/null || true
                fi
                if [ -n "${METRICS_IMAGE:-}" ]; then
                    docker image rm "$METRICS_IMAGE" 2>/dev/null || true
                fi
                rm -rf 'Ex 6/__pycache__'
            '''
        }
    }
}
