pipeline {
    agent { label 'linux-python' }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'BUILD_DOCKER_IMAGE',
            defaultValue: false,
            description: 'Build the optional Docker image on a Docker-capable agent'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Environment verification') {
            steps {
                dir('Ex 7') {
                    sh '''
                        set -eu
                        python3 --version
                        python3 -c 'import sys; assert sys.version_info >= (3, 10), sys.version'
                        git --version
                    '''
                }
            }
        }

        stage('Dependency installation') {
            steps {
                dir('Ex 7') {
                    sh '''
                        set -eu
                        python3 -m venv .venv-ci
                        .venv-ci/bin/python -m pip install --disable-pip-version-check -r requirements.txt
                    '''
                }
            }
        }

        stage('Automated tests') {
            steps {
                dir('Ex 7') {
                    sh '.venv-ci/bin/python -m unittest discover -s . -p "test_*.py" -v'
                }
            }
        }

        stage('Build verification') {
            steps {
                dir('Ex 7') {
                    sh '''
                        set -eu
                        .venv-ci/bin/python -m py_compile app.py test_app.py
                        output=$(.venv-ci/bin/python app.py --name 'Jenkins CI')
                        test "$output" = 'Hello, Jenkins CI!'
                        printf '%s\\n' "$output"
                    '''
                }
            }
        }

        stage('Optional Docker image build') {
            when {
                expression { params.BUILD_DOCKER_IMAGE }
            }
            steps {
                dir('Ex 7') {
                    sh '''
                        set -eu
                        docker version
                        docker build --tag "ex7-ci-demo:${BUILD_NUMBER}" .
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('Ex 7') {
                sh 'rm -rf .venv-ci __pycache__'
            }
            script {
                if (params.BUILD_DOCKER_IMAGE) {
                    sh 'docker image rm "ex7-ci-demo:${BUILD_NUMBER}" 2>/dev/null || true'
                }
            }
        }
    }
}
